# ==============================================================================
# DubbingStory — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in your API keys:
#   cp .env.sample .env
# ==============================================================================

# [REQUIRED] Google Gemini API Key — used for narration script writing
# Also used for visual understanding when VISION_PROVIDER=gemini (default)
# Get yours at: https://aistudio.google.com/apikey
# Free tier supports image/video analysis with rate limits
GOOGLE_API_KEY=your-gemini-api-key-here

# [OPTIONAL] NVIDIA NIM API Key — fallback vision model
# Get yours at: https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key-here

# ── OpenAI-compatible Vision (for HuggingFace models like Qwen3-VL) ──────
# Set VISION_PROVIDER=openai to use a local vLLM server or HF Inference API
# instead of Gemini for visual understanding.
# Narration script writing still uses Gemini.

# VISION_PROVIDER=openai
# OPENAI_VISION_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_VISION_API_KEY=local
# OPTIONAL: How to reference images sent to the OpenAI-compatible vision server.
# - file: use file://<absolute-path> references (preferred for local vLLM on Colab/Kaggle)
# - data: embed full data:base64 URIs (safe fallback but increases prompt size)
# OPENAI_VISION_IMAGE_MODE=file
# OPTIONAL: default max tokens requested from the vision model (will be budgeted
# automatically against model context). Lower to reduce output length.
# OPENAI_VISION_MAX_TOKENS=1024
# OPTIONAL: known model maximum context length (tokens). If unset defaults to 8192.
# OPENAI_VISION_MODEL_MAX_CONTEXT=8192

# [OPTIONAL] HuggingFace API Key — for downloading gated models
# Get yours at: https://huggingface.co/settings/tokens
# HF_API_KEY=hf_xxxxx
