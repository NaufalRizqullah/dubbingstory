# ==============================================================================
# DubbingStory — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in your API keys:
#   cp .env.sample .env
# ==============================================================================

# [REQUIRED] Google Gemini API Key — used for visual understanding & narration
# Get yours at: https://aistudio.google.com/apikey
# Free tier supports image/video analysis with rate limits
GOOGLE_API_KEY=your-gemini-api-key-here

# [OPTIONAL] NVIDIA NIM API Key — fallback vision model
# Get yours at: https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key-here
